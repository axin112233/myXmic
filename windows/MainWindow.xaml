<Window x:Class="myXmic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="myXmic Server" Width="420" Height="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="端口:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPort" Text="8125" Width="70" Margin="6,0,16,0"/>
            <CheckBox x:Name="ChkHideMic" IsChecked="True" VerticalAlignment="Center"
                      Content="关闭程序时从系统隐藏虚拟麦克风"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button x:Name="BtnToggle" Height="40" Width="200"
                    Content="启 动 服 务" FontSize="16" Click="BtnToggle_Click"/>
            <Button x:Name="BtnInstallDriver" Height="40" Width="180" Margin="12,0,0,0"
                    Content="一键安装虚拟声卡" Click="BtnInstallDriver_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="状态" Margin="0,12,0,0">
            <StackPanel Margin="8">
                <TextBlock x:Name="TxtDevice" Text="虚拟声卡: 检测中…" Margin="0,2"/>
                <TextBlock x:Name="TxtUsb" Text="USB(adb): 检测中…" Margin="0,2"/>
                <TextBlock x:Name="TxtConn" Text="手机: 未连接" Margin="0,2"/>
                <ProgressBar x:Name="Level" Height="10" Margin="0,6,0,0"
                             Minimum="0" Maximum="100"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="3" x:Name="TxtLog" TextWrapping="Wrap" FontSize="11"
                   Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</Window>
