<Window x:Class="myXmic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="myXmic" Width="720" Height="560"
        WindowStartupLocation="CenterScreen" Background="#0F1115"
        Foreground="#E8EAF2" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 顶栏 -->
            <RowDefinition Height="Auto"/>  <!-- 连接卡 -->
            <RowDefinition Height="Auto"/>  <!-- 状态卡 -->
            <RowDefinition Height="Auto"/>  <!-- 侦听 -->
            <RowDefinition Height="Auto"/>  <!-- 设置 -->
            <RowDefinition Height="*"/>     <!-- 日志 -->
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 语言 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BtnLang" DockPanel.Dock="Right" Width="60" Content="EN"
                    Background="#2A2F3A" Foreground="#E8EAF2" BorderThickness="0"
                    Click="BtnLang_Click"/>
            <TextBlock Text="myXmic" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 连接卡 -->
        <Border Grid.Row="1" Background="#171B24" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="LblConn" Text="连接方式" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox x:Name="CmbMode" Width="170" SelectedIndex="0">
                        <ComboBoxItem>USB (ADB)</ComboBoxItem>
                        <ComboBoxItem>Wi-Fi (TCP)</ComboBoxItem>
                        <ComboBoxItem>Wi-Fi (UDP)</ComboBoxItem>
                        <ComboBoxItem>蓝牙 Bluetooth</ComboBoxItem>
                    </ComboBox>
                    <TextBlock x:Name="LblPort" Text="端口" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="TxtPort" Text="8125" Width="70" Background="#0F1115"
                             Foreground="#E8EAF2" BorderBrush="#2A2F3A"/>
                    <Button x:Name="BtnToggle" Width="170" Margin="14,0,0,0" Height="36"
                            FontSize="15" FontWeight="SemiBold" Background="#4F6BFF"
                            Foreground="White" BorderThickness="0"
                            Content="启 动" Click="BtnToggle_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtMyIps" Text="本机 IP: …" Foreground="#9AA4BF" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 状态卡 -->
        <Border Grid.Row="2" Background="#171B24" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtDevice" Text="虚拟声卡: …" Foreground="#9AA4BF" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtUsb" Text="USB: -" Foreground="#9AA4BF" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtStats" Text="码率: - kbps" Foreground="#9AA4BF" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLevel" Text="电平" Foreground="#9AA4BF" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="Level" Height="14" Minimum="0" Maximum="100"
                                 Background="#0F1115" Foreground="#4F6BFF"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 侦听卡（独立于虚拟声卡输出） -->
        <Border Grid.Row="3" Background="#171B24" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ChkMonitor" Content="🎧 侦听我的声音（本机扬声器回放，不影响虚拟声卡输出）"
                              FontWeight="SemiBold" Foreground="#E8EAF2"
                              Checked="Monitor_Changed" Unchecked="Monitor_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="LblMonGain" Text="侦听音量" Foreground="#9AA4BF" VerticalAlignment="Center"/>
                    <Slider x:Name="MonGain" Width="260" Minimum="0.1" Maximum="3.0" Value="1.0"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            ValueChanged="MonGain_ValueChanged"/>
                    <TextBlock x:Name="TxtMonGain" Text="100%" Foreground="#9AA4BF" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设置卡 -->
        <Border Grid.Row="4" Background="#171B24" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LblGain" Text="增益" Foreground="#9AA4BF" VerticalAlignment="Center"/>
                    <Slider x:Name="GainSlider" Width="220" Minimum="0.1" Maximum="3.0" Value="1.0"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            ValueChanged="GainSlider_ValueChanged"/>
                    <TextBlock x:Name="TxtGain" Text="100%" Foreground="#9AA4BF" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="ChkHideMic" IsChecked="True" Foreground="#E8EAF2"
                              Content="退出时隐藏虚拟麦克风" VerticalAlignment="Center"/>
                    <Button x:Name="BtnInstallDriver" Content="一键安装虚拟声卡" Margin="20,0,0,0"
                            Background="#2A2F3A" Foreground="#E8EAF2" BorderThickness="0"
                            Padding="12,6" Click="BtnInstallDriver_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="5" Background="#171B24" CornerRadius="12" Padding="10">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                     Background="Transparent" Foreground="#7A829C" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
