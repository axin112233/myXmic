<Window x:Class="myXmic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="myXmic Server" Width="460" Height="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接方式 + 语言 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button x:Name="BtnLang" DockPanel.Dock="Right" Content="EN"
                    Width="44" Click="BtnLang_Click"/>
            <TextBlock x:Name="LblMode" Text="连接方式:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbMode" Width="120" Margin="8,0,0,0" SelectedIndex="0">
                <ComboBoxItem>TCP (推荐)</ComboBoxItem>
                <ComboBoxItem>UDP (低延迟)</ComboBoxItem>
                <ComboBoxItem>蓝牙 Bluetooth</ComboBoxItem>
            </ComboBox>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="LblPort" Text="端口:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPort" Text="8125" Width="70" Margin="6,0,16,0"/>
            <CheckBox x:Name="ChkHideMic" IsChecked="True" VerticalAlignment="Center"
                      Content="退出时隐藏虚拟麦克风"/>
        </StackPanel>

        <!-- 音量 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="LblGain" Text="音量:" VerticalAlignment="Center"/>
            <Slider x:Name="GainSlider" Width="220" Minimum="0.1" Maximum="3.0" Value="1.0"
                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                    ValueChanged="GainSlider_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtGain" Text="100%" Width="48" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 本机 IP（手机 Wi-Fi 模式用） -->
        <TextBlock Grid.Row="3" x:Name="TxtMyIps" Text="本机 IP: …" Foreground="DarkSlateBlue"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10">
            <Button x:Name="BtnToggle" Height="40" Width="190"
                    Content="启 动 服 务" FontSize="15" Click="BtnToggle_Click"/>
            <Button x:Name="BtnInstallDriver" Height="40" Width="170" Margin="12,0,0,0"
                    Content="一键安装虚拟声卡" Click="BtnInstallDriver_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="5" x:Name="GrpStatus" Header="状态">
            <StackPanel Margin="8">
                <TextBlock x:Name="TxtDevice" Text="虚拟声卡: 检测中…" Margin="0,2"/>
                <TextBlock x:Name="TxtUsb" Text="USB(adb): 检测中…" Margin="0,2"/>
                <TextBlock x:Name="TxtConn" Text="手机: 未连接" Margin="0,2"/>
                <ProgressBar x:Name="Level" Height="10" Margin="0,6,0,0" Minimum="0" Maximum="100"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="6" x:Name="TxtLog" TextWrapping="Wrap" FontSize="11"
                   Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</Window>
